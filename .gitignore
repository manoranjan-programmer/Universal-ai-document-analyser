# ==================================================
# Universal AI Document Analyzer - .gitignore
# ==================================================

# Python
__pycache__/
train
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.pyd
*.pyo
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node.js / React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
frontend/build/
frontend/dist/

# Dataset files (DO NOT commit datasets)
dataset/
data/
*.csv
*.json.gz

# Model artifacts (large files - use artifact export)
artifacts/faiss/*.index
artifacts/faiss/*.bin
artifacts/metadata/*.pkl
artifacts/metadata/*.npy

# Uploaded documents (user data)
backend/uploads/
backend/temp/
*.pdf
*.jpg
*.jpeg
*.png

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*.ipynb.bak

# Logs
*.log
logs/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# PyTorch / HuggingFace cache
.cache/
huggingface/
torch_cache/

# Poppler binaries (add your own)
poppler/

# FAISS index files
*.faiss
*.index
